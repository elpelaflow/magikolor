# =============================================================================
# Magikolor — Environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values:
#
#   cp .env.example .env
#
# The only variable REQUIRED for the AI features is OPENAI_API_KEY.
# Everything else has a sensible default and can be left commented out.
# Full documentation: see the "Configuration & Environment Variables"
# section of the README.
# =============================================================================

# -----------------------------------------------------------------------------
# AI — OpenAI
# -----------------------------------------------------------------------------
# Required only for AI palette creation (/api/palette/create and
# /api/palette/clone). Without it those endpoints return 401.
# Default: (empty)
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Database — MongoDB
# -----------------------------------------------------------------------------
# Connection string. Matches the `database` service in compose.yml
# (MongoDB 7.0, port 27018, user magikolor / password secret, db magikolor).
# Default: mongodb://magikolor:secret@localhost:27018/magikolor?authSource=admin
# MONGO_URL=mongodb://magikolor:secret@localhost:27018/magikolor?authSource=admin

# Collection names (only needed if you want to override the defaults).
# Default: palettes
# PALETTE_COLLECTION_NAME=palettes
# Default: feedback
# FEEDBACK_COLLECTION_NAME=feedback

# Timestamp (ms) used to distribute `createdAt` dates when seeding palettes
# with scripts/import-palettes.mjs.
# Default: 1729116912549
# PALLETTE_AI_NAMES_START_DATE_MS=1729116912549

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
# Public site URL. Drives the public apiUrl (`{SITE_URL}/api`) and the i18n
# baseUrl (canonical/SEO links). Matches the dev server port.
# Default: http://localhost:3005
# SITE_URL=http://localhost:3005

# Listen port for Nuxt/Nitro. Used by `npm start`, `npm run preview` and a
# bare `nuxt dev`. NOTE: the `dev` script in package.json hardcodes
# `--port 3005` and the CLI flag wins, so PORT does NOT change `npm run dev`.
# Default: 3005 (dev script) / 3000 (bare nuxt)
# PORT=3011

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# pino log level: trace | debug | info | warn | error | fatal.
# Default: debug
# LOG_LEVEL=debug

# Runtime environment. 'production' switches pino to JSON output and disables
# pino-pretty; 'test' disables logging entirely.
# Default: (unset — development behavior)
# NODE_ENV=development

# -----------------------------------------------------------------------------
# Renderer worker (Color Token Extractor Phase 2)
# -----------------------------------------------------------------------------
# URL of the color-renderer Docker service (headless Chromium/Playwright).
# The /api/color-token-extractor/runtime endpoint returns 502 when the
# worker is offline; everything else works without it.
# Default: http://localhost:3100
# RENDERER_URL=http://localhost:3100

# -----------------------------------------------------------------------------
# Optional — stock photo search (Mood Palette)
# -----------------------------------------------------------------------------
# API keys for the stock image providers used by /api/stock-search.
# Without a key the endpoint falls back to 8 sample images so the tool
# still works.
# Default: (empty — sample fallback)
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# -----------------------------------------------------------------------------
# Renderer worker service (defined in compose.yml, not read from .env)
# -----------------------------------------------------------------------------
# These variables belong to the `renderer` service in compose.yml. To change
# them, edit compose.yml (or pass them there) — the app itself never reads
# them from .env.
#
# PORT=3100              # HTTP port the worker listens on
# MAX_CONCURRENCY=3      # max simultaneous render jobs
# JOB_TIMEOUT_MS=20000   # per-job timeout (20 s)
# CACHE_TTL_MS=3600000   # result cache TTL (1 h, LRU of 200 URLs)
# SCREENSHOT_CACHE_MAX=50  # max cached screenshots (separate small LRU)

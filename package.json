{
  "name": "magikolor",
  "private": true,
  "type": "module",
  "description": "Magikolor is a free and open-source AI color palette generator with a suite of tools for everything color-related.",
  "homepage": "https://magikolor.app",
  "license": "MIT",
  "author": "elpelaflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/elpelaflow/magikolor.git"
  },
  "bugs": {
    "url": "https://github.com/elpelaflow/magikolor/issues"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/check-dev-port.mjs && nuxt dev --port 3005",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxi typecheck",
    "test:parity": "node --experimental-strip-types layers/color-palette-creator/utils/__tests__/palette-parity.test.ts",
    "test:unit": "node --experimental-strip-types scripts/unit-tests.mjs",
    "test:i18n": "node --experimental-strip-types scripts/check-i18n-keys.mjs",
    "test:favorites": "node --experimental-strip-types scripts/test-favorites.mjs",
    "test:image-palettes": "node --experimental-strip-types scripts/test-image-palettes.mjs",
    "test:token-extractor": "node --experimental-strip-types scripts/test-token-extractor.mjs",
    "test:renderer": "node --experimental-strip-types scripts/test-color-renderer.mjs",
    "test": "npm run test:parity && npm run test:unit && npm run test:i18n && npm run test:favorites && npm run test:image-palettes && npm run test:token-extractor && npm run test:renderer"
  },
  "dependencies": {
    "@apideck/better-ajv-errors": "0.3.6",
    "@ckpack/vue-color": "1.6.0",
    "@nuxt/ui": "2.18.7",
    "@nuxt/ui-pro": "1.4.4",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/i18n": "8.5.5",
    "@nuxtjs/plausible": "1.0.2",
    "@sinclair/typebox": "0.33.12",
    "@tanstack/vue-query": "5.56.2",
    "@vueuse/core": "11.1.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "got": "11.8.6",
    "mongodb": "6.9.0",
    "nuxt": "3.13.2",
    "openai": "4.65.0",
    "pino": "8.16.1",
    "pino-pretty": "10.2.3",
    "sharp": "0.33.5",
    "yup": "1.4.0"
  },
  "overrides": {
    "vue": "latest"
  },
  "devDependencies": {
    "@types/twitter-text": "3.1.10",
    "@vue/eslint-config-typescript": "12.0.0",
    "eslint": "8.56.0",
    "eslint-config-standard-with-typescript": "43.0.1",
    "eslint-plugin-vue": "9.20.1",
    "typescript": "5.6.2",
    "vue-tsc": "2.1.6"
  }
}
